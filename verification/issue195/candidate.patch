+"""Issue #195: source-backed fields must not reference themselves in Sigma."""
+
+import json
+import subprocess
+import sys
+
+import pytest
+import yaml
+from ossie import OssieDocument
+
+from ossie_sigma.ossie_to_sigma import OssieToSigmaConverter
+from ossie_sigma.sigma_to_ossie import SigmaToOssieConverter
+
+
+def _extension(data):
+    return [{"vendor_name": "SIGMA", "data": json.dumps(data)}]
+
+
+def _document(*, expression="calendar_date", field_name="calendar_date", dialect="ANSI_SQL",
+              source="db.schema.dim_date_vw", dataset_name="calendar", source_override=None,
+              native_source=None, native_formula=None, sigma_formula=None, primary_sql=False):
+    expr = {"sql": expression} if primary_sql else {
+        "dialects": [{"dialect": dialect, "expression": expression}]}
+    if sigma_formula is not None:
+        expr.setdefault("dialects", []).append({"dialect": "SIGMA", "expression": sigma_formula})
+    field = {"name": field_name, "datatype": "Date", "expression": expr}
+    if native_formula is not None:
+        field["custom_extensions"] = _extension({"native": {"formula": native_formula}})
+    dataset = {"name": dataset_name, "source": source, "primary_key": [field_name], "fields": [field]}
+    extension = {}
+    if source_override is not None:
+        extension["source"] = source_override
+    if native_source is not None:
+        extension["native"] = {"source": native_source}
+    if extension:
+        dataset["custom_extensions"] = _extension(extension)
+    return OssieDocument.model_validate({"version": "0.2.0.dev0", "name": "repro", "datasets": [dataset]})
+
+
+def _element(document):
+    return OssieToSigmaConverter().convert(document).output["pages"][0]["elements"][0]
+
+
+@pytest.mark.parametrize("expression,dialect", [
+    ("calendar_date", "ANSI_SQL"),
+    ('"calendar_date"', "SNOWFLAKE"),
+    ("`calendar_date`", "DATABRICKS"),
+    ("`calendar_date`", "BIGQUERY"),
+    ("((calendar_date))", "ANSI_SQL"),
+    ("calendar.calendar_date", "ANSI_SQL"),
+])
+def test_direct_reference_uses_physical_table_not_dataset_alias(expression, dialect):
+    element = _element(_document(expression=expression, dialect=dialect))
+    assert element["source"]["path"] == ["db", "schema", "dim_date_vw"]
+    assert element["columns"][0]["formula"] == "[dim_date_vw/calendar_date]"
+    assert "name" not in element["columns"][0]
+
+
+def test_original_issue_same_dataset_and_table_name():
+    element = _element(_document(dataset_name="dim_date_vw"))
+    assert element["columns"][0]["formula"] == "[dim_date_vw/calendar_date]"
+
+
+def test_renamed_field_preserves_its_display_name_and_source_column():
+    column = _element(_document(field_name="posting_date"))["columns"][0]
+    assert column["name"] == "posting_date"
+    assert column["formula"] == "[dim_date_vw/calendar_date]"
+
+
+def test_primary_sql_expression_gets_the_same_direct_reference():
+    column = _element(_document(primary_sql=True))["columns"][0]
+    assert column["formula"] == "[dim_date_vw/calendar_date]"
+
+
+def test_physical_identifier_case_is_preserved():
+    element = _element(_document(source="db.schema.DIM_DATE_VW", expression='"CALENDAR_DATE"',
+                                 dialect="SNOWFLAKE", field_name="CALENDAR_DATE"))
+    assert element["columns"][0]["formula"] == "[DIM_DATE_VW/CALENDAR_DATE]"
+
+
+def test_native_sigma_formula_is_not_rewritten():
+    element = _element(_document(sigma_formula="[preserved/calendar_date]"))
+    assert element["columns"][0]["formula"] == "[preserved/calendar_date]"
+
+
+def test_native_column_formula_override_still_wins():
+    element = _element(_document(native_formula="Date([manual/date])"))
+    assert element["columns"][0]["formula"] == "Date([manual/date])"
+
+
+@pytest.mark.parametrize("kind", ["sql", "table", "data-model", "join", "union"])
+def test_non_warehouse_source_formula_and_source_are_unchanged(kind):
+    source = {"kind": kind, "elementId": "input", "connectionId": "test"}
+    element = _element(_document(source_override=source))
+    assert element["source"] == source
+    assert element["columns"][0]["formula"] == "[calendar_date]"
+
+
+def test_native_source_override_controls_physical_reference():
+    source = {"kind": "warehouse-table", "path": ["other", "schema", "NATIVE_DATE"]}
+    element = _element(_document(native_source=source))
+    assert element["source"] == source
+    assert element["columns"][0]["formula"] == "[NATIVE_DATE/calendar_date]"
+
+
+def test_native_non_warehouse_source_does_not_get_a_table_prefix():
+    source = {"kind": "sql", "sql": "SELECT calendar_date FROM dates"}
+    element = _element(_document(native_source=source))
+    assert element["source"] == source
+    assert element["columns"][0]["formula"] == "[calendar_date]"
+
+
+def test_calculated_columns_and_metrics_keep_element_local_references():
+    document = OssieDocument.model_validate({"version": "0.2.0.dev0", "name": "sales", "datasets": [
+        {"name": "orders", "source": "db.public.ORDER_FACT", "fields": [
+            {"name": "amount", "expression": {"sql": "amount"}},
+            {"name": "discount", "expression": {"sql": "amount * 0.9"}},
+        ]}], "metrics": [{"name": "total", "expression": {"sql": "SUM(orders.amount)"}}]})
+    element = _element(document)
+    assert [c["formula"] for c in element["columns"]] == ["[ORDER_FACT/amount]", "([amount] * 0.9)"]
+    assert element["metrics"][0]["formula"] == "Sum([amount])"
+
+
+@pytest.mark.parametrize("expression,expected", [
+    ("other.calendar_date", "[other/calendar_date]"),
+    ("dim_date_vw.calendar_date", "[dim_date_vw/calendar_date]"),
+    ("42", "42"),
+    ("calendar_date + 1", "([calendar_date] + 1)"),
+])
+def test_other_qualifiers_and_non_column_expressions_are_unchanged(expression, expected):
+    assert _element(_document(expression=expression))["columns"][0]["formula"] == expected
+
+
+def test_identical_field_names_keep_separate_physical_sources():
+    document = _document().model_dump(mode="json", by_alias=True, exclude_none=True)
+    document["datasets"].append(_document(dataset_name="other", source="db.other.other_dates").model_dump(
+        mode="json", by_alias=True, exclude_none=True)["datasets"][0])
+    result = OssieToSigmaConverter().convert(OssieDocument.model_validate(document)).output
+    assert [e["columns"][0]["formula"] for e in result["pages"][0]["elements"]] == [
+        "[dim_date_vw/calendar_date]", "[other_dates/calendar_date]"]
+
+
+def test_three_round_trips_preserve_qualified_formula_and_ids():
+    document = _document(field_name="posting_date")
+    original = OssieToSigmaConverter().convert(document).output
+    assert original["pages"][0]["elements"][0]["columns"][0]["formula"] == "[dim_date_vw/calendar_date]"
+    for _ in range(3):
+        document = SigmaToOssieConverter().convert(json.loads(json.dumps(original))).output
+        actual = OssieToSigmaConverter().convert(document).output
+        assert actual == original
+        original = actual
+
+
+def test_real_cli_export_import_export_uses_source_reference(tmp_path):
+    source, native, restored, again = [tmp_path / name for name in ("model.yaml", "sigma.json", "restored.yaml", "again.json")]
+    source.write_text(yaml.safe_dump(_document().model_dump(mode="json", by_alias=True, exclude_none=True)))
+    for command, input_path, output_path in [
+        ("ossie-to-sigma", source, native), ("sigma-to-ossie", native, restored),
+        ("ossie-to-sigma", restored, again),
+    ]:
+        result = subprocess.run([sys.executable, "-m", "ossie_sigma.cli", command,
+                                 "-i", str(input_path), "-o", str(output_path)],
+                                capture_output=True, text=True, check=False, timeout=30)
+        assert result.returncode == 0, result.stderr
+    first = json.loads(native.read_text())
+    assert first["pages"][0]["elements"][0]["columns"][0]["formula"] == "[dim_date_vw/calendar_date]"
+    assert json.loads(again.read_text()) == first
